{
  "name": "@arthurdoity/design-system",
  "version": "0.2.2",
  "description": "Doity Design System — pacote Vue/Nuxt 4 com componentes, tokens e documentação",
  "type": "module",
  "license": "MIT",
  "author": "Doity",
  "keywords": ["vue", "nuxt", "design-system", "doity", "components", "tokens", "ui"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArthurDoity/doity-design-system-vue.git",
    "directory": "packages/design-system"
  },
  "bugs": {
    "url": "https://github.com/ArthurDoity/doity-design-system-vue/issues"
  },
  "homepage": "https://github.com/ArthurDoity/doity-design-system-vue#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    },
    "./tokens.css": "./dist/runtime/assets/css/tokens.css",
    "./base.css": "./dist/runtime/assets/css/base.css",
    "./components.css": "./dist/runtime/assets/css/components.css"
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist",
    "tokens"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "build": "nuxt-module-build build",
    "dev": "nuxi dev playground",
    "dev:playground": "nuxi dev playground",
    "dev:build": "nuxi build playground",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "tokens:generate": "node scripts/generate-tokens.mjs",
    "tokens:sync": "node scripts/sync-figma-tokens.mjs && node scripts/generate-tokens.mjs"
  },
  "dependencies": {
    "@nuxt/kit": "^4.4.8",
    "@vueuse/core": "^13.0.0",
    "reka-ui": "^2.3.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^2.4.1",
    "@nuxt/module-builder": "^1.0.1",
    "@nuxt/schema": "^4.4.8",
    "@storybook/addon-a11y": "^8.6.14",
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/addon-links": "^8.6.14",
    "@storybook/blocks": "^8.6.14",
    "@storybook/vue3": "^8.6.14",
    "@storybook/vue3-vite": "^8.6.14",
    "@vitejs/plugin-vue": "^5.2.3",
    "nuxt": "^4.4.8",
    "storybook": "^8.6.14",
    "unplugin-auto-import": "^19.1.2",
    "vue": "^3.5.16",
    "vue-router": "^4.5.1",
    "vue-tsc": "^2.2.10"
  },
  "peerDependencies": {
    "nuxt": ">=3.0.0 || ^4.0.0",
    "vue": "^3.5.0"
  }
}
